+    "+\tif p.ParameterConversionCalls != 1 || p.FFICalls != 0 || p.ResultConversionCalls != 0 {\n",
+    "+\t\tt.Fatal(p)\n",
+    "+\t}\n",
+    "+}\n",
+    "+\n",
+    "+func TestBoundaryProfileErrorAndMalformedOutput(t *testing.T) {\n",
+    "+\tfor _, tc := range []struct {\n",
+    "+\t\twire      string\n",
+    "+\t\tsuccess   bool\n",
