+    "+\twg.Wait()\n",
+    "+\tp := db.BoundaryProfile()\n",
+    "+\tif p.ParameterConversionCalls != 80 || p.FFICalls != 80 || p.ResultConversionCalls != 80 || freed.Load() != 80 {\n",
+    "+\t\tt.Fatal(p, freed.Load())\n",
+    "+\t}\n",
+    "+}\n",
+    "+\n",
+    "+func TestBoundaryProfileOverflowSaturates(t *testing.T) {\n",
+    "+\tdb := new(DB)\n",
