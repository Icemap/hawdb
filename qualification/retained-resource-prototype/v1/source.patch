+    "+\tcase bool:\n",
+    "+\t\tb := byte(0)\n",
+    "+\t\tif value {\n",
+    "+\t\t\tb = 1\n",
+    "+\t\t}\n",
+    "+\t\tc.bytes([]byte{1, b})\n",
+    "+\tcase int64:\n",
+    "+\t\tc.bytes([]byte{2})\n",
+    "+\t\tc.length(uint64(value))\n",
+    "+\tcase float64:\n",
