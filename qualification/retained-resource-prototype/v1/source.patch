+    "+    Ok(json!({\n",
+    "+        \"status\": \"ok\", \"layer\": \"rust\", \"case\": job.case, \"backend\": job.backend,\n",
+    "+        \"input_rows\": input_rows.len(), \"output_rows\": rows_seen,\n",
+    "+        \"values\": rows_seen * job.columns.len(), \"checksum\": hash.hex(),\n",
+    "+        \"setup_ns\": setup_ns, \"query_boundary_ns\": query_ns,\n",
