+fn largest_admitted_export_wrapper(
+    mut export: impl FnMut(usize) -> Result<()>,
+    ceiling: usize,
+) -> usize {
+    let mut low = 0;
+    let mut high = ceiling;
+    while low < high {
+        let bytes = low + (high - low).div_ceil(2);
+        if export(bytes).is_ok() {
+            low = bytes;
+        } else {
+            high = bytes - 1;
+        }
+    }
+    low
+}
