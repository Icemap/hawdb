load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

load("//:windows_native_features.bzl", "windows_native_feature_dependencies", "windows_native_features")

package(default_visibility = ["//visibility:public"])

test_suite(
    name = "presubmit_tests",
)

rust_library(
    name = "hawdb_telemetry",
    crate_features = windows_native_features("hawdb-telemetry", []),
    crate_name = "hawdb_telemetry",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = windows_native_feature_dependencies("hawdb-telemetry", "opentelemetry", ["@telemetry_crates//:opentelemetry"]) + all_crate_deps(normal = True) + [
        "//crates/qos:hawdb_qos",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "hawdb_telemetry_tests",
    crate = ":hawdb_telemetry",
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)
