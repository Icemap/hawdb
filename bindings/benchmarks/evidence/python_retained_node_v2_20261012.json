  "driver": "\"\"\"Same-source complete-node delivery diagnostic; not full qualification.\"\"\"\nimport gc\nimport hashlib\nimport json\nimport pathlib\nimport struct\nimport sys\nimport time\n\nsys.path.insert(0, sys.argv[1])\nimport hawdb\n\nassert sys.byteorder == \"little\", \"diagnostic checksum requires little-endian host\"\n\nQUERY = \"MATCH (n:Item {id: $id}) RETURN n AS node\"\n\n\ndef consume(db, count, retained):\n    checksum = hashlib.sha256()\n    for key in range(count):\n        if retained:\n            cursor = db.execute_retained_node(QUERY, {\"id\": key})\n            node = cursor.next_node()\n            assert node is not None\n            fields = [node.field(name) for name in (\"_id\", \"id\", \"score\", \"title\", \"nested\", \"labels\")]\n            nested = fields[4].field(\"items\")\n            nested_values = [nested.item(index) for index in range(3)]\n            label = fields[5].item(0)\n            for value, expected_format in zip(fields[:3], (\"q\", \"q\", \"d\")):\n                buffer = memoryview(value)\n                assert buffer.readonly and buffer.format == expected_format and buffer.shape == (1,)\n                checksum.update(buffer)\n                buffer.release()\n            for value in (fields[3], label):\n                buffer = memoryview(value)\n                checksum.update(struct.pack(\"<Q\", buffer.nbytes))\n                checksum.update(buffer)\n                buffer.release()\n            assert nested_values[1].kind == \"null\"\n            for value, expected_format in ((nested_values[0], \"q\"), (nested_values[2], \"?\")):\n                buffer = memoryview(value)\n                assert buffer.readonly and buffer.format == expected_format and buffer.shape == (1,)\n                checksum.update(buffer)\n                buffer.release()\n            assert cursor.next_node() is None\n            for value in (*fields, nested, *nested_values, label, node):\n                value.close()\n            cursor.close()\n        else:\n            node = db.execute(QUERY, {\"id\": key}).fetchone()[\"node\"]\n            checksum.update(struct.pack(\"<qqd\", node[\"_id\"], node[\"id\"], node[\"score\"]))\n            for value in (node[\"title\"], node[\"labels\"][0]):\n                buffer = value.encode(\"utf-8\")\n                checksum.update(struct.pack(\"<Q\", len(buffer)))\n                checksum.update(buffer)\n            assert node[\"nested\"][\"items\"] == [key, None, True]\n            checksum.update(struct.pack(\"<q?\", key, True))\n    return checksum.hexdigest()\n\n\ndef main():\n    output = pathlib.Path(sys.argv[2])\n    with output.open(\"w\") as records:\n        for count in (128, 1000):\n            for width in (256, 16384):\n                db = hawdb.open()\n                db.execute(\"CREATE NODE TABLE Item\")\n                db.execute(\"CREATE INDEX ON :Item(id)\")\n                for key in range(count):\n                    db.execute(\"CREATE (:Item {id: $id, score: $score, title: $title, nested: $nested})\", {\n                        \"id\": key, \"score\": key + 0.5,\n                        \"title\": \"x\" * width + \"\\x00\\u754c\\U0001f642\",\n                        \"nested\": {\"items\": [key, None, True]},\n                    })\n                identity_base = db.execute(QUERY, {\"id\": 0}).fetchone()[\"node\"][\"_id\"]\n                independent = hashlib.sha256()\n                for key in range(count):\n                    independent.update(struct.pack(\"<qqd\", identity_base + key, key, key + 0.5))\n                    for value in ((\"x\" * width + \"\\x00\\u754c\\U0001f642\").encode(\"utf-8\"), b\"Item\"):\n                        independent.update(struct.pack(\"<Q\", len(value)))\n                        independent.update(value)\n                    independent.update(struct.pack(\"<q?\", key, True))\n                expected = independent.hexdigest()\n                assert consume(db, count, False) == expected\n                assert consume(db, count, True) == expected\n                for iteration in range(9):\n                    for retained in ((False, True) if iteration % 2 == 0 else (True, False)):\n                        gc.collect()\n                        start = time.perf_counter_ns()\n                        checksum = consume(db, count, retained)\n                        elapsed = time.perf_counter_ns() - start\n                        assert checksum == expected\n                        snapshot = db.retained_snapshot_copy()\n                        assert snapshot[\"retained_bytes\"] == snapshot[\"view_handles\"] == 0\n                        records.write(json.dumps({\n                            \"mode\": \"retained\" if retained else \"owned\", \"count\": count,\n                            \"width\": width, \"iteration\": iteration, \"discarded\": iteration == 0,\n                            \"elapsed_ns\": elapsed, \"checksum\": checksum,\n                            \"retained_snapshot\": snapshot,\n                        }) + \"\\n\")\n                        records.flush()\n                db.close()\n\n\nif __name__ == \"__main__\":\n    main()\n",
