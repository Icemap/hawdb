  "driver_source": "use hawdb::{Database, Value, RetainedNodeField, RetainedQueryOptions};\nuse std::collections::BTreeMap;\nuse std::hint::black_box;\nuse std::time::Instant;\nconst QUERY: &str = \"MATCH (n:Item {score: $key}) RETURN n AS node\";\nfn text(v: &str) -> u64 { v.bytes().fold(0, |h,b| h.wrapping_mul(1099511628211).wrapping_add(b as u64)) }\nfn mix(h: u64, v: u64) -> u64 { h.wrapping_mul(1099511628211).wrapping_add(v) }\nfn value(v: &Value) -> u64 {\n match v {\n Value::Null => 0, Value::Bool(v) => *v as u64, Value::Int(v) => *v as u64, Value::Float(v) => v.to_bits(),\n Value::String(v) => text(v), Value::Binary(v) => v.iter().fold(0, |h,v|mix(h,*v as u64)),\n Value::List(v) => v.iter().fold(0, |h,v|mix(h,value(v))),\n Value::Map(v) => v.iter().fold(0u64, |h,(k,v)|h.wrapping_add(mix(text(k),value(v)))),\n Value::Uuid(_) => panic!(\"fixture has no UUID\"),\n }\n}\nfn call(db: &mut Database, key: usize, mode: &str) -> u64 {\n let params=BTreeMap::from([(\"key\".into(),Value::Int(key as i64))]);\n if mode==\"owned\" {\n  let out=db.query_with_params(QUERY,&params).unwrap();\n  assert_eq!(out.rows.len(),1);\n  value(out.rows[0].get(\"node\").unwrap())\n } else {\n  let mut cursor=db.query_with_params_retained_node(QUERY,&params,RetainedQueryOptions::default()).unwrap();\n  let view=cursor.next_node().unwrap().unwrap();\n  let mut h=view.properties().unwrap().fold(0u64,|h,(k,v)|h.wrapping_add(mix(text(k),value(v))));\n  let Some(RetainedNodeField::Identity(id))=view.field(\"_id\").unwrap() else {panic!(\"identity\")};\n  h=h.wrapping_add(mix(text(\"_id\"),id as u64));\n  let Some(RetainedNodeField::Labels(labels))=view.field(\"labels\").unwrap() else {panic!(\"labels\")};\n  h=h.wrapping_add(mix(text(\"labels\"),labels.iter().fold(0,|h,s|mix(h,text(s)))));\n  assert!(cursor.next_node().unwrap().is_none());\n  assert_eq!(cursor.profile().source_constructed_bytes,0);\n  assert_eq!(cursor.profile().source_pinned_rows,1);\n  h\n }\n}\nfn check_observations(db: &mut Database, calls: usize) {\n let digest=hawdb_query::QueryIdentity::new(\"cypher\", QUERY);\n let out=db.query_sql_with_params(\"SELECT execution_count, total_row_count, error_count FROM system.statement_summary WHERE digest = $1\", &[Value::String(digest.query_digest().to_owned())]).unwrap();\n assert_eq!(out.rows.len(),1);\n assert_eq!(out.rows[0].get(\"execution_count\"),Some(&Value::Int(calls as i64)));\n assert_eq!(out.rows[0].get(\"total_row_count\"),Some(&Value::Int(calls as i64)));\n assert_eq!(out.rows[0].get(\"error_count\"),Some(&Value::Int(0)));\n}\nfn main() {\n for rows in [128usize,1000,10000] {\n  let mut db=Database::new();\n  db.query(\"CREATE NODE TABLE Item\").unwrap();\n  db.query(\"CREATE PROPERTY ON NODE TABLE Item(score) TYPE INT\").unwrap();\n  db.query(\"CREATE INDEX ON :Item(score)\").unwrap();\n  for start in (0..rows).step_by(512) {\n   let values=(start..(start+512).min(rows)).map(|key| Value::Map(BTreeMap::from([(\"score\".into(),Value::Int(key as i64)),(\"text\".into(),Value::String(format!(\"payload-{key:08}-{}\", \"x\".repeat(256))))]))).collect();\n   db.query_with_params(\"UNWIND $rows AS row CREATE (:Item {score: row.score, text: row.text, _id: 'shadow', labels: 'shadow'})\", &BTreeMap::from([(\"rows\".into(),Value::List(values))])).unwrap();\n  }\n  let mut expected=None;\n  let mut completed_calls=0;\n  for mode in [\"owned\",\"native\"] {\n   let checksum=(0..rows).fold(0u64,|h,key| h.wrapping_add(black_box(call(&mut db,key,mode))));\n   completed_calls+=rows;check_observations(&mut db,completed_calls);\n   if let Some(expected)=expected {assert_eq!(checksum,expected);} else {expected=Some(checksum);}\n  }\n  for round in 0..9 {\n   let modes=if round%2==0 {[\"owned\",\"native\"]} else {[\"native\",\"owned\"]};\n   for mode in modes {\n    let start=Instant::now();\n    let checksum=(0..rows).fold(0u64,|h,key|h.wrapping_add(black_box(call(&mut db,key,mode))));\n    let elapsed=start.elapsed().as_nanos();assert_eq!(checksum,expected.unwrap());\n    completed_calls+=rows;check_observations(&mut db,completed_calls);\n    println!(\"{}\",serde_json::json!({\"rows\":rows,\"mode\":mode,\"round\":round,\"discarded\":round==0,\"calls\":rows,\"elapsed_ns\":elapsed,\"checksum\":checksum}));\n   }\n  }\n }\n}\n",
