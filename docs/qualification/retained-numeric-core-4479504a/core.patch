+fn scores(batch: &RetainedQueryBatch) -> Vec<i64> {
+    let RetainedColumnValues::Int64(values) = batch.column(0).unwrap() else {
+        panic!("integer column");
+    };
+    batch
+        .selected_rows()
+        .iter()
+        .map(|row| values[*row as usize])
