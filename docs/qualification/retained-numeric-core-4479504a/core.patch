+        ),
+        _ => return None,
+    };
+    if projections.is_empty()
+        || !projections
+            .iter()
+            .all(|projection| match &projection.expression {
+                ProjectionExpression::Id { .. } => true,
+                ProjectionExpression::Property { property, .. } => property == fragment.property,
+                _ => false,
+            })
+    {
+        return None;
+    }
+    Some(RetainedNumericPlan {
+        fragment,
+        projections,
+        offset,
+        limit,
+    })
+}
+
