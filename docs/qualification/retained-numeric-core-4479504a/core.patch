+            let error = builder
+                .push_node(&node(0, Some(Value::String("x".repeat(4096)))))
+                .unwrap_err();
+            assert!(error.to_string().len() < 100);
+        } else {
+            builder.push_node(&node(0, Some(Value::Int(3)))).unwrap();
+            assert!(builder.push_node(&node(1, Some(Value::Int(3)))).is_err());
