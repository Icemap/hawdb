+        PhysicalPlan::ProjectExec { items, input } => {
+            (NumericFragment::try_prepare(items, input, catalog)?, items)
+        }
+        PhysicalPlan::NodeProjectionScanExec {
+            variable,
+            label,
+            access,
+            predicate: Some(predicate),
+            items,
+            ..
