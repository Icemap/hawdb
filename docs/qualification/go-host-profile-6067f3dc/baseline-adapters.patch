new file mode 100644
index 00000000..156f5833
--- /dev/null
+++ b/bindings/go/boundary_profile_enabled.go
@@ -0,0 +1,84 @@
+// Copyright 2026 Nowledge
+// SPDX-License-Identifier: Apache-2.0
+//go:build hawdb_boundary_profile
+
+package hawdb
+
+import (
+	"math"
+	"sync/atomic"
+	"time"
+)
+
+const boundaryProfiling = true
+
+// BoundaryProfile contains cumulative host-side wall times for developer
+// qualification builds using hawdb_boundary_profile. Parameter conversion
+// includes prepareValue and JSON encoding; result conversion includes native
+// buffer copying/freeing, JSON decoding and normalization (or error decoding).
+// FFICallNS includes the entire native call; native profile phases nest inside
+// it and must not be added to it. Lock acquisition and result consumption are
+// outside these phases. Snapshots read counters independently; use serial
+// queries and before/after differences for operation-level measurements.
+type BoundaryProfile struct {
+	ParameterConversionNS    uint64 `json:"parameter_conversion_ns"`
+	ParameterConversionCalls uint64 `json:"parameter_conversion_calls"`
+	FFICallNS                uint64 `json:"ffi_call_ns"`
+	FFICalls                 uint64 `json:"ffi_calls"`
+	ResultConversionNS       uint64 `json:"result_conversion_ns"`
+	ResultConversionCalls    uint64 `json:"result_conversion_calls"`
+	Saturated                bool   `json:"saturated"`
+}
+
+type boundaryProfileState struct {
+	parameterNS    atomic.Uint64
+	parameterCalls atomic.Uint64
+	ffiNS          atomic.Uint64
+	ffiCalls       atomic.Uint64
+	resultNS       atomic.Uint64
+	resultCalls    atomic.Uint64
+	saturated      atomic.Bool
+}
+
+func (p *boundaryProfileState) add(counter *atomic.Uint64, value uint64) {
+	for {
+		before := counter.Load()
+		after := before + value
+		if value > math.MaxUint64-before {
+			after = math.MaxUint64
+			p.saturated.Store(true)
+		}
+		if counter.CompareAndSwap(before, after) {
+			return
+		}
+	}
+}
+
+func (p *boundaryProfileState) record(ns, calls *atomic.Uint64, started time.Time) {
+	p.add(ns, uint64(max(time.Since(started).Nanoseconds(), 0)))
+	p.add(calls, 1)
+}
+
+func (p *boundaryProfileState) recordParameter(started time.Time) {
+	p.record(&p.parameterNS, &p.parameterCalls, started)
+}
+
+func (p *boundaryProfileState) recordFFI(started time.Time) {
+	p.record(&p.ffiNS, &p.ffiCalls, started)
+}
+
+func (p *boundaryProfileState) recordResult(started time.Time) {
+	p.record(&p.resultNS, &p.resultCalls, started)
+}
+
+// BoundaryProfile returns host-side counters, including failed query phases.
+// It remains readable after Close. Saturated profiles cannot qualify timing.
+func (db *DB) BoundaryProfile() BoundaryProfile {
+	p := &db.boundaryProfile
+	return BoundaryProfile{
+		ParameterConversionNS: p.parameterNS.Load(), ParameterConversionCalls: p.parameterCalls.Load(),
+		FFICallNS: p.ffiNS.Load(), FFICalls: p.ffiCalls.Load(),
+		ResultConversionNS: p.resultNS.Load(), ResultConversionCalls: p.resultCalls.Load(),
+		Saturated: p.saturated.Load(),
+	}
+}
diff --git a/bindings/go/boundary_profile_test.go b/bindings/go/boundary_profile_test.go
new file mode 100644
index 00000000..bde0c827
--- /dev/null
+++ b/bindings/go/boundary_profile_test.go
@@ -0,0 +1,142 @@
+// Copyright 2026 Nowledge
+// SPDX-License-Identifier: Apache-2.0
+//go:build hawdb_boundary_profile
+
+package hawdb
+
+import (
+	"bytes"
+	"math"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+	"unsafe"
+)
+
+// A Go callback stands in for the C ABI so conversion, errors and ownership can
+// be checked independently of database execution or an installed native library.
+func profileFixture(wire string, success bool) (*DB, *atomic.Uint64) {
+	data := []byte(wire)
+	freed := new(atomic.Uint64)
+	call := func(_ unsafe.Pointer, _ *byte, _ uintptr, _ *byte, _ uintptr, result, failure *ffiBuffer) bool {
+		target := result
+		if !success {
+			target = failure
+		}
+		*target = ffiBuffer{ptr: unsafe.SliceData(data), len: uintptr(len(data))}
+		return success
+	}
+	return &DB{lib: &Library{query: call, querySQL: call,
+		bufferFree: func(buffer *ffiBuffer) { freed.Add(1); *buffer = ffiBuffer{} },
+		close:      func(unsafe.Pointer) {},
+	}}, freed
+}
+
+func TestBoundaryProfileConversionsAndBufferRelease(t *testing.T) {
+	db, freed := profileFixture(`{"columns":["value"],"rows":[[{"$binary":"AAE="}]]}`, true)
+	original := db.lib.query
+	db.lib.query = func(ptr unsafe.Pointer, text *byte, textLen uintptr, params *byte, paramsLen uintptr, result, failure *ffiBuffer) bool {
+		encoded := unsafe.Slice(params, paramsLen)
+		if !bytes.Contains(encoded, []byte(`"$binary":"AAE="`)) {
+			t.Errorf("tagged parameter missing: %s", encoded)
+		}
+		time.Sleep(2 * time.Millisecond)
+		return original(ptr, text, textLen, params, paramsLen, result, failure)
+	}
+	result, err := db.Query("RETURN $value", map[string]any{"value": []byte{0, 1}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(result.Rows[0][0].([]byte), []byte{0, 1}) {
+		t.Fatal(result)
+	}
+	p := db.BoundaryProfile()
+	if p.ParameterConversionCalls != 1 || p.FFICalls != 1 || p.ResultConversionCalls != 1 || p.Saturated {
+		t.Fatal(p)
+	}
+	if p.FFICallNS < uint64(2*time.Millisecond) {
+		t.Fatalf("native call interval was omitted: %+v", p)
+	}
+	if freed.Load() != 1 {
+		t.Fatalf("native result not released: %d", freed.Load())
+	}
+	db.Close()
+	if db.BoundaryProfile() != p {
+		t.Fatal("close changed query counters")
+	}
+	if _, err := db.Query("closed", nil); err == nil {
+		t.Fatal("closed handle accepted")
+	}
+	if db.BoundaryProfile() != p {
+		t.Fatal("closed rejection counted conversion work")
+	}
+}
+
+func TestBoundaryProfileParameterFailureDoesNotCountNativeWork(t *testing.T) {
+	db, _ := profileFixture(`{"columns":[],"rows":[]}`, true)
+	_, err := db.Query("RETURN $bad", map[string]any{"bad": make(chan int)})
+	if err == nil || !strings.Contains(err.Error(), "marshal parameters") {
+		t.Fatal(err)
+	}
+	p := db.BoundaryProfile()
+	if p.ParameterConversionCalls != 1 || p.FFICalls != 0 || p.ResultConversionCalls != 0 {
+		t.Fatal(p)
+	}
+}
+
+func TestBoundaryProfileErrorAndMalformedOutput(t *testing.T) {
+	for _, tc := range []struct {
+		wire      string
+		success   bool
+		errorText string
+	}{
+		{`{"kind":"admission","message":"refused"}`, false, "admission: refused"},
+		{`{`, true, "malformed result JSON"},
+	} {
+		db, freed := profileFixture(tc.wire, tc.success)
+		_, err := db.QuerySQL("SELECT 1")
+		if err == nil || !strings.Contains(err.Error(), tc.errorText) {
+			t.Fatalf("%q: %v", tc.wire, err)
+		}
+		p := db.BoundaryProfile()
+		if p.ParameterConversionCalls != 1 || p.FFICalls != 1 || p.ResultConversionCalls != 1 || p.Saturated {
+			t.Fatal(p)
+		}
+		if freed.Load() != 1 {
+			t.Fatal("failure buffer was not released")
+		}
+	}
+}
+
+func TestBoundaryProfileConcurrentQueries(t *testing.T) {
+	db, freed := profileFixture(`{"columns":["value"],"rows":[[1]]}`, true)
+	var wg sync.WaitGroup
+	for range 8 {
+		wg.Go(func() {
+			for range 10 {
+				if _, err := db.Query("RETURN 1", nil); err != nil {
+					t.Error(err)
+				}
+			}
+		})
+	}
+	wg.Wait()
+	p := db.BoundaryProfile()
+	if p.ParameterConversionCalls != 80 || p.FFICalls != 80 || p.ResultConversionCalls != 80 || freed.Load() != 80 {
+		t.Fatal(p, freed.Load())
+	}
+}
+
+func TestBoundaryProfileOverflowSaturates(t *testing.T) {
+	db := new(DB)
+	p := &db.boundaryProfile
+	p.parameterNS.Store(math.MaxUint64 - 1)
+	p.add(&p.parameterNS, 2)
+	p.add(&p.parameterNS, 10)
+	snapshot := db.BoundaryProfile()
+	if snapshot.ParameterConversionNS != math.MaxUint64 || !snapshot.Saturated {
+		t.Fatal(snapshot)
+	}
+}
